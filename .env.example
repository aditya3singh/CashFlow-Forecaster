# =============================================
# CashFlow Forecaster — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──
DATABASE_URL=postgresql://cashflow:cashflow@localhost:5432/cashflow_db

# ── Security ──
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-with-fernet

# ── Plaid (stubbed for now — fill when ready for Phase 2) ──
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── SendGrid (stubbed for now — fill when ready for Phase 4) ──
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@cashflowforecaster.com

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── App ──
APP_ENV=development
APP_NAME=CashFlow Forecaster
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
